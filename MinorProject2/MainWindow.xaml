<Window x:Class="MinorProject2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minor Project 2"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Grid Background="{DynamicResource AppBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0"
                    Margin="15"
                    Background="{DynamicResource AppBackground}">

            <TextBlock Text="Minor Project 2"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,25"
                       Foreground="{DynamicResource AppForeground}"/>

            <Button Content="Members"
                    Height="40"
                    Margin="0,0,0,10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="MembersButton_Click"/>

            <Button Content="Trainers"
                    Height="40"
                    Margin="0,0,0,10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="TrainersButton_Click"/>

            <Button Content="Exercises"
                    Height="40"
                    Margin="0,0,0,10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="ExercisesButton_Click"/>

            <Button Content="Settings"
                    Height="40"
                    Margin="0,0,0,10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="SettingsButton_Click"/>

            <Button Content="Administration"
                    Height="40"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="AdministrationButton_Click"/>

        </StackPanel>

        <!-- Page Content -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource AppBackground}"/>

    </Grid>

</Window>