<Page x:Class="MinorProject2.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="{DynamicResource AppBackground}"
      Foreground="{DynamicResource AppForeground}">

    <Grid Margin="30"
          Background="{DynamicResource AppBackground}">

        <StackPanel>

            <!-- Title -->
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,25"
                       Foreground="{DynamicResource AppForeground}"/>

            <!-- Appearance -->
            <TextBlock Text="Appearance"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource AppForeground}"/>

            <TextBlock Text="Choose the application theme:"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource AppForeground}"/>

            <!-- Theme Buttons -->
            <StackPanel Orientation="Horizontal">

                <Button Content="Light Theme"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        Foreground="{DynamicResource AppForeground}"
                        Click="LightThemeButton_Click"/>

                <Button Content="Dark Theme"
                        Width="120"
                        Height="35"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        Foreground="{DynamicResource AppForeground}"
                        Click="DarkThemeButton_Click"/>

            </StackPanel>

            <!-- Current Theme -->
            <TextBlock x:Name="ThemeStatusText"
                       Text="Current theme: Light"
                       Margin="0,20,0,0"
                       Foreground="{DynamicResource AppForeground}"/>

        </StackPanel>

    </Grid>

</Page>