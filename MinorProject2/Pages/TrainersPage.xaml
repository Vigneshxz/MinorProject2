<Page x:Class="MinorProject2.Pages.TrainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Trainers"
      Background="{DynamicResource AppBackground}"
      Foreground="{DynamicResource AppForeground}">

    <Grid Margin="20"
          Background="{DynamicResource AppBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Trainers"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Foreground="{DynamicResource AppForeground}"/>

        <!-- Trainer Information -->
        <GroupBox Grid.Row="1"
                  Header="Trainer Information"
                  Margin="0,0,0,15"
                  Background="{DynamicResource ControlBackground}"
                  Foreground="{DynamicResource AppForeground}"
                  BorderBrush="{DynamicResource ControlBorder}">

            <StackPanel Orientation="Horizontal"
                        Margin="10">

                <!-- First Name -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="First Name"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="FirstNameBox"
                             Width="130"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Last Name -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Last Name"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="LastNameBox"
                             Width="130"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Specialty -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Specialty"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="SpecialtyBox"
                             Width="150"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Email"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="EmailBox"
                             Width="180"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- CRUD Buttons -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,18,0,0">

                    <Button Content="Add Trainer"
                            Width="100"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="AddTrainerButton_Click"/>

                    <Button Content="Update"
                            Width="80"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="UpdateTrainerButton_Click"/>

                    <Button Content="Delete"
                            Width="80"
                            Height="30"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="DeleteTrainerButton_Click"/>

                </StackPanel>

            </StackPanel>

        </GroupBox>

        <!-- Trainers Table -->
        <DataGrid x:Name="TrainersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionChanged="TrainersGrid_SelectionChanged"
                  Background="{DynamicResource ControlBackground}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  Foreground="{DynamicResource AppForeground}"/>

    </Grid>

</Page>