<Page x:Class="MinorProject2.Pages.MembersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Members"
      Background="{DynamicResource AppBackground}"
      Foreground="{DynamicResource AppForeground}">

    <Grid Margin="20"
          Background="{DynamicResource AppBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Members"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Foreground="{DynamicResource AppForeground}"/>

        <!-- Search -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="First Name"
                           Foreground="{DynamicResource AppForeground}"/>

                <TextBox x:Name="FirstNameSearchBox"
                         Width="150"
                         Background="{DynamicResource ControlBackground}"
                         BorderBrush="{DynamicResource ControlBorder}"
                         Foreground="{DynamicResource AppForeground}"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Last Name"
                           Foreground="{DynamicResource AppForeground}"/>

                <TextBox x:Name="LastNameSearchBox"
                         Width="150"
                         Background="{DynamicResource ControlBackground}"
                         BorderBrush="{DynamicResource ControlBorder}"
                         Foreground="{DynamicResource AppForeground}"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Email"
                           Foreground="{DynamicResource AppForeground}"/>

                <TextBox x:Name="EmailSearchBox"
                         Width="200"
                         Background="{DynamicResource ControlBackground}"
                         BorderBrush="{DynamicResource ControlBorder}"
                         Foreground="{DynamicResource AppForeground}"/>
            </StackPanel>

            <Button Content="Search"
                    Width="90"
                    Height="30"
                    Margin="0,18,10,0"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="SearchButton_Click"/>

            <Button Content="Show All"
                    Width="90"
                    Height="30"
                    Margin="0,18,0,0"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Foreground="{DynamicResource AppForeground}"
                    Click="ShowAllButton_Click"/>

        </StackPanel>

        <!-- Add / Update / Delete Member -->
        <GroupBox Grid.Row="2"
                  Header="Member Information"
                  Margin="0,0,0,15"
                  Background="{DynamicResource ControlBackground}"
                  Foreground="{DynamicResource AppForeground}"
                  BorderBrush="{DynamicResource ControlBorder}">

            <StackPanel Orientation="Horizontal"
                        Margin="10">

                <!-- First Name -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="First Name"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="FirstNameBox"
                             Width="130"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Last Name -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Last Name"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="LastNameBox"
                             Width="130"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Email"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="EmailBox"
                             Width="180"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Phone"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="PhoneBox"
                             Width="120"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,18,0,0">

                    <Button Content="Add Member"
                            Width="100"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="AddMemberButton_Click"/>

                    <Button Content="Update"
                            Width="80"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="UpdateMemberButton_Click"/>

                    <Button Content="Delete"
                            Width="80"
                            Height="30"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="DeleteMemberButton_Click"/>

                </StackPanel>

            </StackPanel>

        </GroupBox>

        <!-- Members Table -->
        <DataGrid x:Name="MembersGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionChanged="MembersGrid_SelectionChanged"
                  Background="{DynamicResource ControlBackground}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  Foreground="{DynamicResource AppForeground}"/>

    </Grid>

</Page>