<Page x:Class="MinorProject2.Pages.ExercisesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Exercises"
      Background="{DynamicResource AppBackground}"
      Foreground="{DynamicResource AppForeground}">

    <Grid Margin="20"
          Background="{DynamicResource AppBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Exercises"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Foreground="{DynamicResource AppForeground}"/>

        <!-- Exercise Information -->
        <GroupBox Grid.Row="1"
                  Header="Exercise Information"
                  Margin="0,0,0,15"
                  Background="{DynamicResource ControlBackground}"
                  Foreground="{DynamicResource AppForeground}"
                  BorderBrush="{DynamicResource ControlBorder}">

            <StackPanel Orientation="Horizontal"
                        Margin="10">

                <!-- Exercise Name -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Exercise Name"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="ExerciseNameBox"
                             Width="150"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Muscle Group -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Muscle Group"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="MuscleGroupBox"
                             Width="130"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Equipment -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Equipment"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="EquipmentBox"
                             Width="120"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Difficulty -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Difficulty"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBox x:Name="DifficultyBox"
                             Width="120"
                             Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource ControlBorder}"
                             Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- CRUD Buttons -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,18,0,0">

                    <Button Content="Add Exercise"
                            Width="105"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="AddExerciseButton_Click"/>

                    <Button Content="Update"
                            Width="80"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="UpdateExerciseButton_Click"/>

                    <Button Content="Delete"
                            Width="80"
                            Height="30"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Foreground="{DynamicResource AppForeground}"
                            Click="DeleteExerciseButton_Click"/>

                </StackPanel>

            </StackPanel>

        </GroupBox>

        <!-- Exercises Table -->
        <DataGrid x:Name="ExercisesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionChanged="ExercisesGrid_SelectionChanged"
                  Background="{DynamicResource ControlBackground}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  Foreground="{DynamicResource AppForeground}"/>

    </Grid>

</Page>